# ---------------------------------------------------------------------------
# C++ API Gateway configuration
#
# Copy this file to `.env` for the native workflow (run.py / build/api_gateway).
# The gateway itself reads plain environment variables; run.py loads this file
# with python-dotenv. Docker Compose does NOT use this file for the container
# values -- those are set explicitly in docker-compose.yml with container-
# correct service names (see the "Docker Compose" section at the bottom).
# ---------------------------------------------------------------------------

# Port the gateway listens on. Default: 8080.
GATEWAY_PORT=8080

# Comma-separated list of backend addresses as host:port. At least one is
# required; any number of backends is supported. Default when unset:
# 127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003
BACKENDS=127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003

# Elastic token-bucket rate limiting. RATE_LIMITING_ENABLED accepts true/false
# (or 1/0). Capacity and refill rate are token counts / tokens-per-second.
RATE_LIMITING_ENABLED=true
RATE_LIMIT_CAPACITY=100000
RATE_LIMIT_REFILL_RATE=100000

# Redis connection used by the distributed rate limiter. REDIS_PORT is a
# string, not an integer. Defaults: 127.0.0.1 / 6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Timeouts in milliseconds (must be positive integers).
# - BACKEND_CONNECT_TIMEOUT_MS: bounds DNS resolution + TCP connect.
# - BACKEND_RESPONSE_TIMEOUT_MS: bounds waiting for the backend HTTP response.
# - REQUEST_TIMEOUT_MS: overall per-request deadline shared across retries.
BACKEND_CONNECT_TIMEOUT_MS=2000
BACKEND_RESPONSE_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=10000

# Bounded grace period (ms) for graceful shutdown before remaining
# connections are force-closed. Default: 5000.
SHUTDOWN_GRACE_PERIOD_MS=5000

# Load-balancing strategy. Valid values: ROUND_ROBIN, LEAST_CONNECTIONS.
# Invalid values make startup fail. Default: ROUND_ROBIN.
LOAD_BALANCING_STRATEGY=ROUND_ROBIN

# ---------------------------------------------------------------------------
# Docker Compose (host-side overrides only)
#
# The values above are application settings. When running the Compose stack,
# the gateway receives container-correct values from docker-compose.yml
# (for example REDIS_HOST=redis and BACKENDS=backend-a:9001,backend-b:9002).
# The variables below only change which host ports the services are published
# on; they never reach the application.
#
#   GATEWAY_HOST_PORT     host port mapped to the gateway (default 8080)
#   PROMETHEUS_HOST_PORT  host port mapped to Prometheus  (default 9090)
#   GRAFANA_HOST_PORT     host port mapped to Grafana     (default 3000)
#
# Example: GATEWAY_HOST_PORT=18080
#
# ---------------------------------------------------------------------------
# Scaling the number of sample backends
#
# The base docker-compose.yml runs two backends (backend-a, backend-b). To run
# a different number, generate a Compose file with N uniquely addressable
# backends and a matching gateway BACKENDS list:
#
#   python scripts/generate_compose.py --count 4
#   docker compose -f docker-compose.generated.yml up --build
#   docker compose -f docker-compose.generated.yml down
#
# Each backend is a separate service (backend-1 ... backend-N) with its own
# port (--base-port, default 9001) and health check, so the gateway registers
# and health-checks every one. The existing docker-compose.yml is unchanged.
# Invalid counts (0, negative, or a count that would exceed port 65535) are
# rejected with a clear error. Practical limits are host CPU/RAM and the TCP
# port range; low tens of backends are comfortable on a laptop.
# ---------------------------------------------------------------------------
